# ============================================================
# DiagFlow — Environment Configuration
# Copy this file to .env next to DiagFlow.exe (or in project root)
# ============================================================

# --- Central Database (Production / Multi-PC LAN) ---
# Point both to the central MSSQL server on your network (hostname or server name):
SLIS_DB_CONNECTION_STRING=mssql+pyodbc://diagflow_user:your_password@server_hostname/SlisDB?driver=ODBC+Driver+17+for+SQL+Server
CONFIG_DB_CONNECTION_STRING=mssql+pyodbc://diagflow_user:your_password@server_hostname/SlisDB?driver=ODBC+Driver+17+for+SQL+Server

# --- Operation Mode ---
# Set to 'false' in production so the app connects to the central DB (df_ tables).
# Set to 'true' for local offline development / testing (uses local SQLite files).
USE_MOCK_SLIS_DB=false
MOCK_SLIS_DB_PATH=db/mock_slis.db

# --- Rule Engine Weights (Defaults, can also be tuned via Admin UI) ---
WEIGHT_PARTNERSHIP=0.35
WEIGHT_PATIENT_HISTORY=0.20
WEIGHT_SKILLS=0.20
WEIGHT_LAB=0.15
WEIGHT_CAPACITY=0.10

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=production
LOG_LEVEL=INFO
