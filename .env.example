# ============================================================
# DiagFlow — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# Slis DB (read-only access to existing Slis tables)
SLIS_DB_CONNECTION_STRING=mssql+pyodbc://user:password@server/SlisDB?driver=ODBC+Driver+17+for+SQL+Server

# Config DB (DiagFlow's own tables — can be same as Slis or separate)
CONFIG_DB_CONNECTION_STRING=mssql+pyodbc://user:password@server/SlisDB?driver=ODBC+Driver+17+for+SQL+Server

# --- LLM / Comment Parser ---
# API endpoint for the LLM used to parse free-text comments
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini

# --- Rule Engine Weights ---
# These control the relative importance of each scoring factor (0.0 to 1.0)
WEIGHT_CAPACITY=0.30
WEIGHT_SKILLS=0.25
WEIGHT_PARTNERSHIP=0.25
WEIGHT_PATIENT_HISTORY=0.15
WEIGHT_SUBCATEGORY_PENALTY=0.05

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=DEBUG
