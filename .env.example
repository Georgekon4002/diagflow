# ============================================================
# DiagFlow — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# Slis DB (read-only access to existing Slis tables)
SLIS_DB_CONNECTION_STRING=mssql+pyodbc://user:password@server/SlisDB?driver=ODBC+Driver+17+for+SQL+Server

# Config DB (DiagFlow's own tables — can be same as Slis or separate)
CONFIG_DB_CONNECTION_STRING=mssql+pyodbc://user:password@server/SlisDB?driver=ODBC+Driver+17+for+SQL+Server

# Mock Slis DB — use local SQLite in development (no SQL Server driver needed)
# Set to false in production when real Slis DB access is available.
# When False, DiagFlow executes the following stored procedures on the real Slis DB:
#   - EXEC getWardDoctors (on launch: syncs new issuing/ward doctors into diagflow.db)
#   - EXEC getExamsListForPeriod 'YYYY-MM-DD', 'YYYY-MM-DD' (on launch: pulls unassigned exams from last 3 days)
#   - EXEC getdiagnosticsList (on admin 'Refresh': syncs new diagnosticians into diagflow.db)
USE_MOCK_SLIS_DB=true
MOCK_SLIS_DB_PATH=db/mock_slis.db



# --- Rule Engine Weights ---
# These control the relative importance of each scoring factor (0.0 to 1.0)
WEIGHT_PARTNERSHIP=0.35
WEIGHT_PATIENT_HISTORY=0.20
WEIGHT_SKILLS=0.20
WEIGHT_LAB=0.15
WEIGHT_CAPACITY=0.10

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=DEBUG
