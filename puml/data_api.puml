@startuml

title DiagFlow — Class Diagram: Data Access & Engine Layer
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Inter
skinparam shadowing false
skinparam classAttributeIconSize 0

' ─── Data Access Layer ───

package "diagflow.db" as db_pkg #B2EBF2 {

    class "diagflow_db.py" as cfg_db <<module>> {
        - _DB_PATH: Path
        - _conn(): ContextManager[Connection]
        - _row_to_dict(row): dict
        __ Diagnosticians __
        + get_all_diagnosticians(): list[dict]
        + get_diagnostician(id): dict | None
        + create_diagnostician(...): dict
        + update_diagnostician(...): dict | None
        + delete_diagnostician(id): bool
        __ Skills __
        + get_skills(diag_id): list[dict]
        + upsert_skill(diag_id, exam_code, preferred): dict
        + delete_skill(skill_id): bool
        + get_skills_for_diagnostician(id): list[dict]
        + get_all_skills_grouped(): dict[int, list[dict]]
        __ Partnerships __
        + get_all_partnerships(): list[dict]
        + create_partnership(...): dict
        + update_partnership(id, ...): dict | None
        + delete_partnership(id): bool
        + get_partnerships_by_doctor(doc_id): list[dict]
        + get_exclusive_partnerships(): dict[str, dict]
        __ Availability __
        + get_all_availability(): list[dict]
        + upsert_availability(...): dict
        + get_absent_diagnostician_ids(date): set[int]
        __ Παμμακάριστος __
        + init_pamakristos_schedule(): void
        + get_pamakristos_weekly_schedule_db(): list[dict]
        + update_pamakristos_weekly_schedule_db(items): void
        + get_oncall_diagnostician(date): dict | None
        __ Doctors __
        + get_all_doctors(q, skip, limit): dict
        + upsert_doctor(id, name, specialty): dict
        + delete_doctor(id): bool
        __ Local Assignments __
        + upsert_local_assignment(exammoreid, ...): dict
        + get_all_local_assignments(): dict[int, dict]
        + get_daily_assignment_counts(): dict[int, int]
        + delete_local_assignment(exammoreid): bool
    }

    class "engines.py" as engines <<module>> {
        - _slis_engine: Engine
        - _config_engine: Engine
        - _SlisSession: sessionmaker
        - _ConfigSession: sessionmaker
        --
        + init_engines(): void
        + dispose_engines(): void
        + get_slis_session(): Session
        + get_config_session(): Session
        ..
        <<for future MSSQL use>>
    }

    ' ─── ORM Models (Reference, not used in prod) ───

    package "ORM Models (reference)" as orm_pkg #E0E0E0 {
        class "Diagnostician" as orm_diag {
            + id: int <<PK>>
            + name: str
            + active: bool
            + can_ct: bool
            + can_mri: bool
            --
            + skills: list[DiagnosticianSkill]
            + capacity: DiagnosticianCapacity
            + lab_preferences: list[DiagnosticianLabPreference]
            + availability_records: list[DiagnosticianAvailability]
        }

        class "DiagnosticianSkill" as orm_skill {
            + id: int <<PK>>
            + diagnostician_id: int <<FK>>
            + exam_code: str
            + is_preferred: bool
        }

        class "Partnership" as orm_partner {
            + id: int <<PK>>
            + issuing_doctor_id: str
            + preferred_diagnostician_id: int <<FK>>
            + priority: int
        }

        class "AssignmentLog" as orm_log {
            + id: int <<PK>>
            + exam_id: str
            + patient_id: str
            + suggested_diagnostician_id: int <<FK>>
            + final_diagnostician_id: int <<FK>>
            + was_overridden: bool
            + rules_fired: str (JSON)
            + score_breakdown: str (JSON)
        }

        orm_diag "1" -- "0..*" orm_skill
        orm_diag "1" -- "0..*" orm_partner
        orm_diag "1" -- "0..*" orm_log
    }
}

' ─── Rule Engine ───

package "diagflow.engine" as engine_pkg #BBDEFB {

    class "ExamContext" as exam_ctx <<dataclass>> {
        + exam_id: str
        + patient_id: str
        + patient_name: str
        + modality: str (CT/MRI/MRA)
        + body_part: str
        + exam_code: str
        + exam_name: str
        + lab_id: str
        + lab_name: str
        + issuing_doctor_id: str
        + issuing_doctor_name: str
        + comments: str
        + is_pamakristos: bool
        + request_date: date | None
    }

    class "CandidateDiagnostician" as candidate <<dataclass>> {
        + id: int
        + name: str
        + can_ct: bool
        + can_mri: bool
        + is_available: bool
        + daily_quota: int
        + current_day_count: int
        + skill_proficiency: float
        + has_skill_match: bool
        + has_skill_data: bool
        + accepts_lab: bool
        + is_partnership_match: bool
        + is_partnership_exclusive: bool
        + has_patient_history: bool
        + patient_history_count: int
        + is_excluded_by_comment: bool
        + is_directly_assigned_by_comment: bool
    }

    class "FilterResult" as filter_result <<dataclass>> {
        + passed: bool
        + rule_name: str
        + reason: str
    }

    class "filters.py" as filters <<module>> {
        + filter_by_availability(candidate, exam): FilterResult
        + filter_by_capacity(candidate, exam): FilterResult
        + filter_by_modality(candidate, exam): FilterResult
        + filter_by_skills_hard(candidate, exam): FilterResult
        + filter_by_lab_preference(candidate, exam): FilterResult
        + filter_by_comment_exclusion(candidate, exam): FilterResult
        --
        + apply_hard_filters(candidates, exam): (list, dict)
        + get_elimination_reason(id, results): str | None
    }

    class "ScoreComponent" as score_comp <<dataclass>> {
        + rule_name: str
        + display_name: str
        + raw_score: float (0.0–1.0)
        + weight: float
        + weighted_score: float
        + explanation: str
    }

    class "CandidateScore" as cand_score <<dataclass>> {
        + diagnostician_id: int
        + diagnostician_name: str
        + total_score: float
        + components: list[ScoreComponent]
        + rank: int
    }

    class "scoring.py" as scoring <<module>> {
        + score_skills_weighted(candidate, exam): ScoreComponent
        + score_patient_history(candidate, exam): ScoreComponent
        + score_partnership(candidate, exam): ScoreComponent
        + score_lab_preference(candidate, exam): ScoreComponent
        + score_capacity(candidate): ScoreComponent
        --
        + compute_candidate_score(candidate, exam): CandidateScore
        + score_all_candidates(candidates, exam): list[CandidateScore]
    }

    class "SolverAssignment" as solver_assign <<dataclass>> {
        + exam_id: str
        + diagnostician_id: int
        + diagnostician_name: str
        + score: float
        + is_optimal: bool
    }

    class "SolverResult" as solver_result <<dataclass>> {
        + assignments: list[SolverAssignment]
        + solver_status: str
        + solve_time_ms: float
    }

    class "solver.py" as solver <<module>> {
        + solve_single_assignment(exam, scored): SolverResult
        + solve_batch_assignment(exams, ...): SolverResult
        - _greedy_fallback(exams, scores): SolverResult
    }

    class "AssignmentSuggestion" as suggestion <<dataclass>> {
        + exam_id: str
        + patient_id: str
        + exam_summary: str
        + suggested_diagnostician_id: int
        + suggested_diagnostician_name: str
        + confidence_score: float
        + score_breakdown: list[dict]
        + alternatives: list[dict]
        + rules_fired: list[str]
        + filter_results: dict
        + solver_status: str
        + pipeline_timestamp: str
    }

    class "AssignmentPipeline" as pipeline {
        - _comment_parser: None
        --
        + run(exam, candidates): AssignmentSuggestion | None
        - _build_alternatives(...): list[dict]
        - _build_exclusive_assignment_suggestion(...): AssignmentSuggestion
    }
}

' ─── Relationships ───

' Pipeline flow
pipeline --> filters : "Stage 1:\napply_hard_filters()"
pipeline --> scoring : "Stage 2:\nscore_all_candidates()"
pipeline --> solver : "Stage 4:\nsolve_single_assignment()"
pipeline --> suggestion : creates

' Filter/scoring data
filters ..> exam_ctx : uses
filters ..> candidate : evaluates
filters --> filter_result : produces

scoring ..> exam_ctx : uses
scoring ..> candidate : scores
scoring --> cand_score : produces
cand_score *-- score_comp : contains

solver ..> cand_score : takes
solver --> solver_result : produces
solver_result *-- solver_assign : contains

' Data layer connections
cfg_db ..> candidate : "data feeds into\n(via DiagnosticianService)"
engines ..> orm_diag : "would use\n(future MSSQL)"

@enduml
