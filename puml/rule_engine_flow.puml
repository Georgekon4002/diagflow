@startuml

title DiagFlow — Rule Engine Pipeline
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Inter
skinparam shadowing false

start

:Receive pending exam\n(ExamContext);

partition "**Stage 0: Exclusive Partnership & Routing Check**" #F3E5F5 {
    if (Doctor has exclusive partner OR\nmatches dynamic exam routing rule?) then (yes)
        :Auto-assign directly to\ndesignated diagnostician;
        :Return AssignmentSuggestion\nwith rule explanation;
        stop
    else (no)
    endif
}

partition "**Stage 1: Hard Filters**" #E8EAF6 {
    :Fetch all active diagnosticians\n(from diagflow.db);
    note right
        DiagnosticianService loads:
        • Availability (absent IDs)
        • Skills & Lab preferences
        • Partnerships for doctor
        • Daily counts (assignment_log)
        • Per-weekday quotas
        • Dynamic routing & quota rules
    end note

    :Apply **filter_by_exclusive_lab_dynamic()**;
    note right
        Check if diagnostician is bound
        exclusively to a specific lab.
    end note

    :Apply **filter_by_availability()**;
    note right
        On leave today?
        Day off (weekday quota = 0)?
    end note

    :Apply **filter_by_capacity()**;
    note right
        current_day_count ≥ daily_quota?
        (weekday-specific quotas)
    end note

    :Apply **filter_by_modality_quotas_dynamic()**;
    note right
        Reached specific CT/MRI
        modality daily max count?
    end note

    :Apply **filter_by_modality()**;
    note right
        can_ct / can_mri flag
        matches exam modality?
    end note

    :Apply **filter_by_skills_hard()**;
    note right
        Only eliminates if skill record
        exists AND proficiency == 0.
        No data = passes (neutral score later).
    end note

    :Collect all FilterResults\n(even for eliminated candidates);
    note right
        Eliminated candidates are kept
        in the alternatives list with
        red indicator + reason for the UI.
    end note

    if (Any candidates passed?) then (no)
        :Return None\n(manual assignment required);
        stop
    else (yes)
    endif
}

partition "**Stage 2: Weighted Scoring**" #E3F2FD {
    :Fetch dynamic weights from **system_settings**;

    :Compute **score_skills_weighted()**;
    note right
        Preferred exam code → max bonus
        Neutral match → mid bonus
        No data → min bonus
    end note

    :Compute **score_patient_history()**;
    note right
        Same diagnostician for same
        patient's past similar exams.
    end note

    :Compute **score_partnership()**;
    note right
        Doctor partnership match → max score
    end note

    :Compute **score_lab_preference()**;
    note right
        Preferred lab matches → max score
        Different preference → min score
        No preference → neutral score
    end note

    :Compute **score_capacity()**;
    note right
        remaining / daily_quota
        At quota → 0.0
        Fully available → 1.0
    end note

    :Sum weighted scores\nClamp to [0.0, 1.0];
}

partition "**Stage 3: Near-Tie Load Balancing**" #E8F5E9 {
    :Find top_score among all candidates;

    :Identify near-tie group:\n|top_score − candidate_score| ≤ tolerance (5%);
    note right
        Includes session workload offset
        (_session_suggestion_counts) to balance
        sequential proposals in real-time.
    end note

    if (Multiple near-tied candidates?) then (yes)
        :Sort near-tie group by:\n1. Fewest exams today (+ session offset)\n2. Largest daily quota\n3. Random jitter;
    else (no)
        :Keep strict score ordering;
    endif

    :Candidates outside tolerance:\nsorted strictly by score;
}

partition "**Stage 4: Solver**" #FFF8E1 {
    if (Single exam?) then (yes)
        :Greedy: pick rank #1 candidate\nafter tie-breaking;
    else (batch)
        :OR-Tools CP-SAT:\nMaximise total score\nacross all exams\nrespecting quota constraints;
    endif
}

partition "**Output**" #FFF3E0 {
    :Build **AssignmentSuggestion**:
    • suggested diagnostician
    • confidence score
    • score breakdown (per factor)
    • alternatives (scored + eliminated)
    • rules that fired
    • solver status
    • pipeline timestamp;

    :Cache suggestion for\nconfirm/override flow;

    :Send to Review Dashboard;
}

stop

@enduml
