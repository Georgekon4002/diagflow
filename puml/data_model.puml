@startuml data_model

title DiagFlow — Data Model Overview
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Inter
skinparam shadowing false
skinparam linetype ortho

' ─── DiagFlow Config Database (diagflow.db) ───
package "diagflow.db — Config & State" as diagflow_db #E3F2FD {

    entity "diagnosticians" as diag {
        * **id** : INTEGER <<PK>>
        --
        * name : TEXT
        * active : INTEGER (0/1)
        can_ct : INTEGER (0/1)
        can_mri : INTEGER (0/1)
        quota_monday..sunday : INTEGER
        preferred_lab_id : INTEGER
    }

    entity "diagnostician_skills" as skills {
        * **id** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER <<FK>>
        * exam_code : TEXT
        is_preferred : INTEGER (0/1)
        --
        UNIQUE(diagnostician_id, exam_code)
    }

    entity "partnerships" as partners {
        * **id** : INTEGER <<PK>>
        --
        * issuing_doctor_id : TEXT <<FK>>
        * issuing_doctor_name : TEXT
        * preferred_diagnostician_id : INTEGER <<FK>>
        priority : INTEGER
        exclusive : INTEGER (0/1)
        is_active : INTEGER (0/1)
    }

    entity "availability" as avail {
        * **id** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER <<FK>>
        * date : TEXT (ISO-8601)
        * status : TEXT
        is_pamakristos_oncall : INTEGER (0/1)
        notes : TEXT
        --
        UNIQUE(diagnostician_id, date)
    }

    entity "doctors" as docs {
        * **id** : TEXT <<PK>>
        --
        * name : TEXT
    }

    entity "local_assignments" as local_assign {
        * **exammoreid** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER
        * diagnostician_name : TEXT
        * assigned_at : TEXT (ISO-8601)
        is_auto : INTEGER (0/1)
        rule_desc : TEXT
    }

    entity "assignment_log" as assign_log {
        * **exammoreid** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER
        * assigned_at : TEXT (ISO-8601)
        modality : TEXT
        extracode : TEXT
    }

    entity "pamakristos_schedule" as pam_sched {
        * **weekday** : INTEGER <<PK>> (0–6)
        --
        * diagnostician_id : INTEGER <<FK>>
    }

    entity "exam_routing_rules" as route_rules {
        * **id** : INTEGER <<PK>>
        --
        lab_id : INTEGER
        is_pamakristos : INTEGER (0/1)
        * exam_codes : TEXT
        * diagnostician_id : INTEGER <<FK>>
        description : TEXT
        issuing_doctor_id : INTEGER
        issuing_doctor_name : TEXT
        is_active : INTEGER (0/1)
    }

    entity "exclusive_lab_rules" as ex_labs {
        * **id** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER <<FK>>
        * lab_id : INTEGER
        lab_name : TEXT
        is_active : INTEGER (0/1)
    }

    entity "modality_quotas" as mod_quotas {
        * **id** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER <<FK>>
        * modality : TEXT (CT/MRI)
        * max_count : INTEGER
        is_active : INTEGER (0/1)
    }

    entity "system_settings" as sys_settings {
        * **key** : TEXT <<PK>>
        --
        * value : TEXT
    }

    entity "exam_dictionary" as exam_dict {
        * **code** : TEXT <<PK>>
        --
        * name : TEXT
        category : TEXT
    }

    entity "admin_users" as admin_users {
        * **id** : INTEGER <<PK>>
        --
        * username : TEXT
        * password_hash : TEXT
        * role : TEXT
        * is_active : INTEGER
    }
}

' ─── Mock Slis Database (mock_slis.db) ───
package "mock_slis.db — Exam Data" as slis_db #FFF3E0 {

    entity "slis_exams" as slis_exam {
        * **exammoreid** : INTEGER <<PK>>
        --
        extracode : INTEGER
        visitid : INTEGER
        demogid : INTEGER
        fname : TEXT
        lname : TEXT
        examnumcode : INTEGER <<FK>>
        examname : TEXT
        visitdate : TEXT
        labcodeid : INTEGER
        laboratoryname : TEXT
        wcode : TEXT
        wname : TEXT
        diagnostis : INTEGER
        code : TEXT
        notes : TEXT
        category : TEXT
        slis_synced_at : TEXT
    }

    entity "exam_categories" as exam_cats {
        * **examnumcode** : INTEGER <<PK>>
        --
        * name : TEXT
        * category : TEXT (CT/MRI/MRA)
    }

    entity "diagnosticians\n(Slis personnel)" as slis_diag {
        * **PERSONELID** : INTEGER <<PK>>
        --
        DOCNAME : TEXT
    }

    entity "doctors\n(Slis doctors)" as slis_docs {
        * **CODE** : INTEGER <<PK>>
        --
        DOCNAME : TEXT
    }
}

' ─── Relationships ───
diag ||--o{ skills : "has skills"
diag ||--o{ partners : "preferred by"
diag ||--o{ avail : "availability\ncalendar"
diag ||--o{ pam_sched : "on-call\nrotation"
diag ||--o{ route_rules : "target diagnostician"
diag ||--o{ ex_labs : "bound lab"
diag ||--o{ mod_quotas : "modality limit"

partners }o--|| docs : "references\ndoctor"

slis_exam }o--|| exam_cats : "exam type\nlookup"

local_assign ..> slis_exam : "references\nexammoreid"
local_assign ..> diag : "references\ndiagnostician"
assign_log ..> diag : "tracks\nassignments"
slis_diag ..> diag : "syncs personnel\n(id, name)"
slis_docs ..> docs : "syncs doctors\n(id, name)"

@enduml
