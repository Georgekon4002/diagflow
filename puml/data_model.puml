@startuml

title DiagFlow — Data Model Overview
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Inter
skinparam shadowing false
skinparam linetype ortho

' ─── DiagFlow Config Database (diagflow.db) ───
package "diagflow.db — Config & State" as diagflow_db #E3F2FD {

    entity "diagnosticians" as diag {
        * **id** : INTEGER <<PK>>
        --
        * name : TEXT
        * active : INTEGER (0/1)
        can_ct : INTEGER (0/1)
        can_mri : INTEGER (0/1)
        quota_monday..sunday : INTEGER
        preferred_lab_id : INTEGER
    }

    entity "diagnostician_skills" as skills {
        * **id** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER <<FK>>
        * exam_code : TEXT
        is_preferred : INTEGER (0/1)
        --
        UNIQUE(diagnostician_id, exam_code)
    }

    entity "partnerships" as partners {
        * **id** : INTEGER <<PK>>
        --
        * issuing_doctor_id : TEXT
        * issuing_doctor_name : TEXT
        * preferred_diagnostician_id : INTEGER <<FK>>
        priority : INTEGER
        exclusive : INTEGER (0/1)
        is_active : INTEGER (0/1)
    }

    entity "availability" as avail {
        * **id** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER <<FK>>
        * date : TEXT (ISO-8601)
        * status : TEXT
        is_pamakristos_oncall : INTEGER (0/1)
        notes : TEXT
        --
        UNIQUE(diagnostician_id, date)
    }

    entity "doctors" as docs {
        * **id** : TEXT <<PK>>
        --
        * name : TEXT
        specialty : TEXT
    }

    entity "local_assignments" as local_assign {
        * **exammoreid** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER
        * diagnostician_name : TEXT
        * assigned_at : TEXT (ISO-8601)
    }

    entity "assignment_log" as assign_log {
        * **exammoreid** : INTEGER <<PK>>
        --
        * diagnostician_id : INTEGER
        * assigned_at : TEXT (ISO-8601)
    }

    entity "pamakristos_schedule" as pam_sched {
        * **weekday** : INTEGER <<PK>> (0–6)
        --
        * diagnostician_id : INTEGER <<FK>>
    }
}

' ─── Mock Slis Database (mock_slis.db) ───
package "mock_slis.db — Exam Data" as slis_db #FFF3E0 {

    entity "slis_exams" as slis_exam {
        * **exammoreid** : INTEGER <<PK>>
        --
        extracode : INTEGER
        visitid : INTEGER
        demogid : INTEGER
        fname : TEXT
        lname : TEXT
        examnumcode : INTEGER <<FK>>
        examname : TEXT
        visitdate : TEXT
        labcodeid : INTEGER
        laboratoryname : TEXT
        wcode : TEXT
        wname : TEXT
        diagnostis : INTEGER
        code : TEXT
        notes : TEXT
        category : TEXT
        slis_synced_at : TEXT
        --
        oldvisit : INTEGER
        oldorder : TEXT
        olddiagnostis : TEXT
        oldpers : INTEGER
    }

    entity "exam_categories" as exam_cats {
        * **examnumcode** : INTEGER <<PK>>
        --
        * name : TEXT
        * category : TEXT (CT/MRI/MRA)
    }
}

' ─── Relationships ───
diag ||--o{ skills : "has skills"
diag ||--o{ partners : "preferred by"
diag ||--o{ avail : "availability\ncalendar"
diag ||--o{ pam_sched : "on-call\nrotation"

partners }o--|| docs : "references\ndoctor"

slis_exam }o--|| exam_cats : "exam type\nlookup"

local_assign ..> slis_exam : "references\nexammoreid"
local_assign ..> diag : "references\ndiagnostician"
assign_log ..> diag : "tracks\nassignments"

@enduml
