@startuml

title DiagFlow — Assignment Sequence

skinparam backgroundColor #FEFEFE
skinparam defaultFontName Inter
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Secretariat\nOperator" as operator
participant "Review\nDashboard" as ui #E8F5E9
participant "FastAPI\nBackend" as api #E3F2FD
participant "Assignment\nService" as assign #B3E5FC
participant "Diagnostician\nService" as diag_svc #B3E5FC
participant "Rule\nEngine" as engine #BBDEFB
database "mock_slis.db" as mockdb #FFE0B2
database "diagflow.db" as configdb #B2EBF2

== Startup: Slis Pull + Auto-Assignments ==

api -> assign : pull_from_slis()
assign -> mockdb : SELECT pending exams\n(last 3 days, no diagnostician)
mockdb --> assign : Raw exam rows
assign -> configdb : Get exclusive partnerships
assign -> configdb : Get exam_routing_rules
assign -> configdb : Get Παμμακάριστος on-call
assign -> assign : Auto-assign:\n1. Exclusive doctor partnerships\n2. Dynamic exam routing rules\n   (e.g., Arthrografies, TMJ, Spectroscopies)\n3. Παμμακάριστος general → on-call
assign -> configdb : upsert_local_assignment()\n(is_auto=True, rule_desc)
assign --> api : Remaining pending exams

== Fetch Pending Exams ==

operator -> ui : Open dashboard
ui -> api : GET /api/exams/pending
api -> assign : get_pending_exams()
assign -> mockdb : Query unassigned exams
assign -> configdb : Check local_assignments\n(exclude already assigned)
assign --> api : Filtered pending list
api --> ui : Pending exams table
ui --> operator : Display pending exams

== Generate Suggestion ==

operator -> ui : Click row → Suggest
ui -> api : POST /api/assignments/suggest\n{ exam_id: "12345" }

api -> diag_svc : get_candidates_for_exam()
diag_svc -> configdb : Batch load:\n• All diagnosticians\n• All skills (grouped)\n• Absent IDs for today\n• Partnerships for doctor\n• Daily assignment counts
configdb --> diag_svc : Enriched candidate list
diag_svc --> api : List<CandidateDiagnostician>

note over api
    Apply session suggestion count (_session_suggestion_counts)
    as virtual workload offset for sequential load-balancing
end note

api -> configdb : get_system_weights()
configdb --> api : Dynamic weights dict

api -> engine : pipeline.run(exam, candidates)

group Stage 0: Exclusive Partnership & Routing Check
    engine -> engine : Any exclusive partner or dynamic routing rule?
    note right : If matched → skip pipeline,\nreturn direct auto-assignment suggestion
end

group Stage 1: Hard Filters
    engine -> engine : filter_by_exclusive_lab_dynamic()
    engine -> engine : filter_by_availability()
    engine -> engine : filter_by_capacity()
    engine -> engine : filter_by_modality_quotas_dynamic()
    engine -> engine : filter_by_modality()
    engine -> engine : filter_by_skills_hard()
    note right
        Eliminated candidates are NOT hidden.
        They appear in alternatives with a red box
        and elimination reason for operator override.
    end note
end

note over engine : N candidates remain\nafter hard filters

group Stage 2: Weighted Scoring
    engine -> engine : score_skills_weighted()
    engine -> engine : score_patient_history()
    engine -> engine : score_partnership()
    engine -> engine : score_lab_preference()
    engine -> engine : score_capacity()
    engine -> engine : Composite score per candidate\n(clamped to 0.0–1.0)
end

group Stage 3: Near-Tie Load Balancing
    engine -> engine : Find top_score
    engine -> engine : Identify near-tie group:\n|top_score − candidate_score| ≤ 5%
    engine -> engine : Sort near-tie group:\nfewest exams today → quota → random
end

group Stage 4: Solver
    engine -> engine : solve_single_assignment()\nGreedy: pick rank #1
end

engine --> api : AssignmentSuggestion:\n{ diagnostician, score,\nbreakdown, alternatives }

note over api : Cache suggestion in _suggestion_cache\nIncrement session workload counter

api --> ui : SuggestionResponse
ui --> operator : Display suggestion:\n"ΠΑΠΑΔΟΠΟΥΛΟΣ (87%)\n✓ Συνεργασία Ιατρού\n✓ Χωρητικότητα: 8/15\n✓ Εξειδίκευση"

== Operator Decision ==

alt Confirm suggestion
    operator -> ui : Click "Confirm"
    ui -> api : POST /api/assignments/confirm\n{ exam_id, diagnostician_id }
    api -> configdb : upsert_local_assignment()
    api --> ui : AssignmentConfirmation
    ui --> operator : ✅ Ανατέθηκε

else Override suggestion
    operator -> ui : Select different diagnostician\n(from alternatives or eliminated)
    ui -> api : POST /api/assignments/override\n{ exam_id, override_id, reason }
    api -> configdb : upsert_local_assignment()
    api --> ui : AssignmentConfirmation\n(was_overridden=true)
    ui --> operator : ⚠️ Αντικαταστάθηκε
end

== Push to Slis ==

operator -> ui : Click "Αποστολή στο Slis"
ui -> api : POST /api/slis/push-all (or push-selected)
api -> assign : push_all_to_slis()
assign -> mockdb : UPDATE slis_exams\nSET slis_synced_at, diagnostis
assign -> configdb : DELETE from local_assignments
assign --> api : { succeeded, failed, queries }
api --> ui : Push result
ui --> operator : ✅ Pushed N exams to Slis

@enduml
