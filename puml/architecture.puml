@startuml

title DiagFlow — Multi-Client Central Database Architecture
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam defaultFontName Inter
skinparam shadowing false

' ─── Central Server (MSSQL) ───
package "Central Server (Hospital LAN / MSSQL)" as central_srv #E8EAF6 {
    database "Central Slis & DiagFlow DB\n(MSSQL — production)" as central_db {
        frame "Slis Native Schema" {
            collections "exammore (exams)" as slis_exams
            collections "Stored Procedures\n(getExamsListForPeriod_V1,\ngetWardDoctors, getdiagnosticsList)" as slis_sps
        }
        frame "DiagFlow Schema (df_* prefix)" as df_schema #E1F5FE {
            collections "df_diagnosticians" as df_diag
            collections "df_diagnostician_skills" as df_skills
            collections "df_partnerships" as df_part
            collections "df_availability" as df_avail
            collections "df_doctors" as df_docs
            collections "df_local_assignments (shared staged)" as df_local
            collections "df_assignment_log (central audit)" as df_log
            collections "df_pamakristos_schedule" as df_pam
            collections "df_exam_routing_rules" as df_rules
            collections "df_exclusive_lab_rules" as df_exlab
            collections "df_modality_quotas" as df_quotas
            collections "df_system_settings" as df_settings
            collections "df_admin_users" as df_admin
            collections "df_exam_dictionary" as df_dict
        }
    }
}

' ─── Mock Development Environment ───
package "Offline / Mock Dev Environment" as mock_env #FFF3E0 {
    database "mock_slis.db & diagflow.db\n(Local SQLite — development)" as local_mock {
        collections "slis_exams" as mock_exams
        collections "local config tables" as mock_cfg
    }
}

' ─── Client Machine A (DiagFlow.exe) ───
package "Client PC 1 (Secretariat / Admin)" as client1 #E3F2FD {
    component "DiagFlow.exe (Client A)\n(PyInstaller + pywebview GUI)" as app1 {
        component "FastAPI Server (Port 8080)" as api1
        component "Rule Engine & OR-Tools Solver" as engine1
        component "Dual-Engine DB Layer\n(diagflow_db.py / engines.py)" as db_layer1
    }
    actor "Operator A" as op1
}

' ─── Client Machine B (DiagFlow.exe) ───
package "Client PC 2 (Secretariat / Admin)" as client2 #E3F2FD {
    component "DiagFlow.exe (Client B)\n(PyInstaller + pywebview GUI)" as app2 {
        component "FastAPI Server (Port 8080)" as api2
        component "Rule Engine & OR-Tools Solver" as engine2
        component "Dual-Engine DB Layer\n(diagflow_db.py / engines.py)" as db_layer2
    }
    actor "Operator B" as op2
}

' ─── Connections ───
op1 --> app1 : "Interacts via Native Window"
op2 --> app2 : "Interacts via Native Window"

db_layer1 --> central_db : "LAN Connection (SQLAlchemy / pyodbc)\nReads/Writes df_* tables & runs SPs"
db_layer2 --> central_db : "LAN Connection (SQLAlchemy / pyodbc)\nReads/Writes df_* tables & runs SPs"

app1 ..> local_mock : "When USE_MOCK_SLIS_DB=true"

note bottom of central_srv
    **Multi-PC Synchronization:**
    * Admin settings changed on PC 1 are stored immediately in central **df_*** tables.
    * Staged assignments in **df_local_assignments** and counts are shared in real time across all PCs.
    * Confirmed assignments update **exammore** and log centrally to **df_assignment_log**.
end note

@enduml
